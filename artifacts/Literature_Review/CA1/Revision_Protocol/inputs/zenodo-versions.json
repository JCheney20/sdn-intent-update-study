642350", "publication_date": "2024-06-13", "description": "<p>This directory contains an implementation of both Spotlight and the baseline exhaustive algorithm. To run the evaluations from the paper in a docker container, execute the `run.sh` script. To run the experiments directly, run `./detector.py`</p>\n<p>Results will be written to a CSV file with the date and time the run started.</p>", "access_right": "open", "creators": [{"name": "Weintraub, Benjamin", "affiliation": "MIT Lincoln Laboratory", "orcid": "0000-0002-9527-5888"}, {"name": "Kim, Jiwon", "affiliation": "Purdue University West Lafayette", "orcid": "0000-0003-3324-8283"}, {"name": "Tao, Ran", "affiliation": "Georgetown University"}, {"name": "Nita-Rotaru, Cristina", "affiliation": "Northeastern University", "orcid": "0000-0002-9649-6789"}, {"name": "Okhravi, Hamed", "affiliation": "MIT Lincoln Laboratory", "orcid": "0000-0003-1450-3744"}, {"name": "Tian, Dave (Jing)", "affiliation": "Purdue University West Lafayette", "orcid": "0000-0002-7506-9593"}, {"name": "Ujcich, Benjamin E.", "affiliation": "Georgetown University", "orcid": "0009-0001-3433-9972"}], "related_identifiers": [{"identifier": "10.1145/3658644.3670301", "relation": "isDescribedBy", "resource_type": "publication-conferenceproceeding", "scheme": "doi"}], "resource_type": {"title": "Software", "type": "software"}, "meeting": {"title": "ACM SIGSAC Conference on Computer and Communications Security", "acronym": "CCS", "dates": "October 14-18", "place": "Salt Lake City, Utah, USA", "url": "https://www.sigsac.org/ccs/CCS2024/"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "11642349"}}]}}, "title": "Spotlight: CCS Artifact", "links": {"self": "https://zenodo.org/api/records/11642350", "self_html": "https://zenodo.org/records/11642350", "preview_html": "https://zenodo.org/records/11642350?preview=1", "doi": "https://doi.org/10.5281/zenodo.11642350", "self